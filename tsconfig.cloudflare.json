{
    "compilerOptions": {
        "composite": true,
        "jsx": "react-jsx",
        "lib": ["DOM", "DOM.Iterable", "ES2024"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "paths": {
            "~/*": ["./src/*"]
        },
        "resolveJsonModule": true,
        "target": "ES2024",
        "types": ["vite/client"]
    },
    "extends": "./tsconfig.json",
    "include": ["src/**/*", "worker-configuration.d.ts"]
}
