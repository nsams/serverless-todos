{
    "compilerOptions": {
        "composite": true,
        "jsx": "react-jsx",
        "lib": ["DOM", "DOM.Iterable", "ES2024"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "paths": {
            "~/*": ["./app/*"]
        },
        "resolveJsonModule": true,
        "rootDirs": [".", "./.react-router/types"],
        "target": "ES2024",
        "types": ["vite/client"]
    },
    "exclude": ["app/db/compiled-functions.*.js"],
    "extends": "./tsconfig.json",
    "include": [".react-router/types/**/*", "app/**/*", "app/**/.server/**/*", "app/**/.client/**/*", "workers/**/*", "worker-configuration.d.ts"]
}
