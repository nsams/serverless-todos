{
    "compilerOptions": {
        "composite": true,
        "jsx": "react-jsx",
        "lib": ["DOM", "DOM.Iterable", "ES2024"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "paths": {
            "~/*": ["./src/*"]
        },
        "resolveJsonModule": true,
        "rootDirs": [".", "./.react-router/types"],
        "target": "ES2024",
        "types": ["vite/client"]
    },
    "exclude": ["src/routes.ts", "src/modules/*/routes.ts"],
    "extends": "./tsconfig.json",
    "include": ["src/**/*", "worker-configuration.d.ts", ".react-router/types/**/*"]
}
