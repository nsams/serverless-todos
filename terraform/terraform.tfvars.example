# Copy to terraform.tfvars (not committed) and fill in.
# Entra ID: Entra admin center → App registrations → the app registration used by Cloudflare Access
entra_directory_id  = "00000000-0000-0000-0000-000000000000"
entra_client_id     = "00000000-0000-0000-0000-000000000000"
entra_client_secret = "..."

# who may use the app
allowed_email_domains = ["vivid-planet.com"]
