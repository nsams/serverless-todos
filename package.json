{
    "name": "serverless-todos",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "react-router build",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "wrangler d1 migrations apply DB --local",
        "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
        "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate",
        "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
        "dev": "dev-pm start @dev",
        "dev:app": "dotenv -e .env.local -e .env -- react-router dev",
        "lint": "run-p lint:prettier lint:eslint lint:tsc",
        "lint:eslint": "eslint --max-warnings 0 .",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "npm run lint:eslint -- --fix",
        "lint:fix:prettier": "npm run lint:prettier -- --write",
        "lint:prettier": "prettier --check '**/*.{ts,mts,tsx,js,mjs,json,jsonc,md,yml,yaml}'",
        "lint:tsc": "npm run typegen && tsc -b",
        "preview": "npm run build && dotenv -e .env.local -e .env -- vite preview",
        "typegen": "wrangler types && react-router typegen"
    },
    "engines": {
        "node": "24"
    },
    "dependencies": {
        "@ai-sdk/openai-compatible": "^3.0.87",
        "@ai-sdk/provider": "^4.0.37",
        "@ai-sdk/react": "^4.0.169",
        "@cloudflare/ai-chat": "^0.12.2",
        "@dextinity/admin-icons": "^10.11.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource-variable/roboto-flex": "^5.3.0",
        "@modelcontextprotocol/server": "2.4.0",
        "@mui/material": "^7.3.11",
        "@mui/x-chat": "9.0.0-alpha.21",
        "@mui/x-data-grid-pro": "^8.29.5",
        "agents": "^0.33.0",
        "ai": "^7.0.165",
        "drizzle-orm": "^0.45.4",
        "isbot": "^5",
        "jose": "^6.2.15",
        "markdown-to-jsx": "^9.10.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.66.0",
        "@dextinity/eslint-config": "^10.11.0",
        "@react-router/dev": "^8.5.1",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "dev-process-manager": "^4.1.0",
        "dotenv-cli": "^11.1.0",
        "drizzle-kit": "^0.31.11",
        "eslint": "^9.39.5",
        "npm-run-all2": "^9.0.4",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "vite": "^8.3.5",
        "wrangler": "^4.156.0"
    }
}
