{
    "name": "serverless-todos",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "react-router build",
        "build:postgres": "CLOUDFLARE_ENV=postgres react-router build",
        "db:generate": "node scripts/migrate.ts generate-d1",
        "db:migrate:d1": "wrangler d1 migrations apply DB --local",
        "db:migrate:d1:remote": "wrangler d1 migrations apply DB --remote",
        "db:migrate:pg": "dotenv -e .env.local -e .env -- node scripts/migrate.ts migrate-pg",
        "deploy": "pnpm run build && wrangler deploy",
        "deploy:postgres": "pnpm run build:postgres && wrangler deploy",
        "dev": "dev-pm start @dev",
        "dev:app": "dotenv -e .env.local -e .env -- react-router dev",
        "dev:app:postgres": "dotenv -e .env.local -e .env -- sh -c 'CLOUDFLARE_ENV=postgres react-router dev'",
        "dev:oidc-provider": "dotenv -e .env.local -e .env -- dev-oidc-provider",
        "dev:postgres": "dev-pm start @dev-postgres",
        "lint": "run-p lint:prettier lint:eslint lint:tsc",
        "lint:eslint": "eslint --max-warnings 0 .",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:prettier": "prettier --check '**/*.{ts,mts,tsx,js,mjs,json,jsonc,md,yml,yaml}'",
        "lint:tsc": "pnpm run typegen && tsc -b",
        "preview": "pnpm run build && vite preview",
        "typegen": "wrangler types && react-router typegen"
    },
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": "24"
    },
    "dependencies": {
        "@dextinity/admin-icons": "^10.11.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource-variable/roboto-flex": "^5.3.0",
        "@mui/material": "^7.3.11",
        "@mui/x-data-grid-pro": "^8.29.5",
        "isbot": "^5.2.2",
        "kysely": "^0.29.8",
        "openid-client": "^6.8.8",
        "pg": "^8.23.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.1"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.66.0",
        "@dextinity/eslint-config": "^10.11.0",
        "@react-router/dev": "^8.5.1",
        "@types/node": "^24.19.2",
        "@types/pg": "^8.23.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "dev-oidc-provider": "^2.1.2",
        "dev-process-manager": "^4.1.0",
        "dotenv-cli": "^11.1.0",
        "eslint": "^9.39.5",
        "npm-run-all2": "^9.0.4",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "vite": "^8.3.5",
        "wrangler": "^4.156.0"
    }
}
