{
    "name": "serverless-todos",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:node": "PLATFORM=node vite build",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "wrangler d1 migrations apply DB --local",
        "db:migrate:node": "dotenv -e .env.local -e .env -- node scripts/migrate.ts",
        "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
        "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate",
        "db:reset:node": "rm -rf .data && npm run db:migrate:node",
        "db:seed": "dotenv -e .env.local -e .env -- node scripts/seed.ts",
        "db:seed:node": "PLATFORM=node npm run db:seed",
        "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy && npm run preview:cleanup",
        "dev": "dev-pm start @dev",
        "dev:app": "dotenv -e .env.local -e .env -- vite dev",
        "dev:node": "dev-pm start @dev-node",
        "dev:node:app": "dotenv -e .env.local -e .env -- env PLATFORM=node vite dev",
        "lint": "run-p lint:prettier lint:eslint lint:tsc",
        "lint:eslint": "eslint --max-warnings 0 .",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "npm run lint:eslint -- --fix",
        "lint:fix:prettier": "npm run lint:prettier -- --write",
        "lint:prettier": "prettier --check '**/*.{ts,mts,tsx,js,mjs,json,jsonc,md,yml,yaml}'",
        "lint:tsc": "npm run typegen && npm run routegen && tsc -b",
        "preview": "npm run build && dotenv -e .env.local -e .env -- vite preview",
        "preview:cleanup": "node scripts/preview.ts cleanup",
        "preview:deploy": "node scripts/preview.ts deploy",
        "routegen": "node scripts/routeTree.ts",
        "start:node": "node scripts/migrate.ts && srvx --prod --static ../client dist/server/server.node.js",
        "typegen": "wrangler types"
    },
    "engines": {
        "node": "24"
    },
    "dependencies": {
        "@ai-sdk/openai-compatible": "^3.0.87",
        "@ai-sdk/provider": "^4.0.37",
        "@ai-sdk/react": "^4.0.169",
        "@dextinity/admin-icons": "^10.11.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource-variable/roboto-flex": "^5.3.0",
        "@libsql/client": "^0.18.0",
        "@modelcontextprotocol/server": "2.4.0",
        "@mui/material": "^7.3.11",
        "@mui/x-chat": "9.0.0-alpha.21",
        "@mui/x-data-grid-pro": "^8.29.5",
        "@tanstack/react-query": "^5.104.5",
        "@tanstack/react-router": "^1.170.46",
        "@tanstack/react-router-ssr-query": "^1.167.3",
        "@tanstack/react-start": "^1.169.4",
        "ai": "^7.0.165",
        "drizzle-orm": "^0.45.4",
        "jose": "^6.2.15",
        "markdown-to-jsx": "^9.10.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "srvx": "^1.0.8",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.66.0",
        "@dextinity/eslint-config": "^10.11.0",
        "@tanstack/router-generator": "^1.167.46",
        "@tanstack/virtual-file-routes": "^1.162.0",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "dev-process-manager": "^4.1.0",
        "dotenv-cli": "^11.1.0",
        "drizzle-kit": "^0.31.11",
        "eslint": "^9.39.5",
        "npm-run-all2": "^9.0.4",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "vite": "^8.3.5",
        "wrangler": "^4.156.0"
    }
}
