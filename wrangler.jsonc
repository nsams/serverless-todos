{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "serverless-todos",
    "compatibility_date": "2026-10-20",
    "compatibility_flags": ["nodejs_compat"],
    // Workers Logs: persisted runtime logs (dashboard → Worker → Observability → Events)
    "observability": {
        "enabled": true,
    },
    "main": "src/server.ts",
    // served on workers.dev, protected by Cloudflare Access (see README); preview URLs would need their own Access setup
    "workers_dev": true,
    "preview_urls": false,
    // overridden locally by .env
    "vars": {
        // https://<team-name>.cloudflareaccess.com (public; used to verify the Access JWT)
        "ACCESS_TEAM_DOMAIN": "https://vivid-planet-sandbox.cloudflareaccess.com",
        // Application Audience (AUD) Tag of the Access application (public, part of every Access JWT)
        "ACCESS_AUD": "dcacc8dc414027c9cafbca4e91f53dcacd16c652f18fee944fd50b646850a67d",
        // Model of the chat assistant: a Workers AI model with function calling (https://developers.cloudflare.com/ai/models/),
        // e.g. "@cf/moonshotai/kimi-k2.6" or the faster, smaller "@cf/zai-org/glm-4.7-flash"
        "AI_MODEL": "@cf/moonshotai/kimi-k2.6",
        // AI Gateway the model requests go through (logs, spend limits); "default" is created on first use
        "AI_GATEWAY_ID": "default",
    },
    // Workers AI / AI Gateway (no provider API keys: billed through the Cloudflare account). Always remote, also in local development.
    "ai": {
        "binding": "AI",
    },
    // The chat assistant: one TodoChatAgent (Durable Object with SQLite storage for the chat history) per user, see src/chat/
    "durable_objects": {
        "bindings": [{ "name": "TodoChatAgent", "class_name": "TodoChatAgent" }],
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TodoChatAgent"] }],
    "d1_databases": [
        {
            "binding": "DB",
            // no database_id: `wrangler deploy` creates the database on first deploy (or connects to an existing one with this name)
            "database_name": "serverless-todos",
            "migrations_dir": "drizzle",
        },
    ],
}
