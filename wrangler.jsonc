{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "serverless-todos",
    "compatibility_date": "2026-10-20",
    "compatibility_flags": ["nodejs_compat"],
    // Workers Logs: persisted runtime logs (dashboard → Worker → Observability → Events)
    "observability": {
        "enabled": true,
    },
    "main": "src/server.cloudflare.ts",
    // served on workers.dev, protected by Cloudflare Access (see README)
    "workers_dev": true,
    // Worker Previews (one per git branch, see README "Preview deployments"), protected by their own Access application
    "preview_urls": true,
    // overridden locally by .env
    "vars": {
        // https://<team-name>.cloudflareaccess.com (public; used to verify the Access JWT)
        "ACCESS_TEAM_DOMAIN": "https://vivid-planet-sandbox.cloudflareaccess.com",
        // Application Audience (AUD) Tag of the Access application (public, part of every Access JWT)
        "ACCESS_AUD": "dcacc8dc414027c9cafbca4e91f53dcacd16c652f18fee944fd50b646850a67d",
        // Model of the chat assistant (src/chat/model.server.ts): an OpenAI-compatible API, the API key is the secret AI_API_KEY
        // (`npx wrangler secret put AI_API_KEY`); without it there is no chat assistant
        "AI_BASE_URL": "https://api.openai.com/v1",
        "AI_MODEL": "gpt-5-mini",
    },
    // Durable Objects aren't used anymore: the chat history is kept in D1 (src/chat/db/). Deletes the former chat agent with its histories.
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["TodoChatAgent"] },
        { "tag": "v2", "renamed_classes": [{ "from": "TodoChatAgent", "to": "ChatAgent" }] },
        { "tag": "v3", "deleted_classes": ["ChatAgent"] },
    ],
    "d1_databases": [
        {
            "binding": "DB",
            // no database_id: `wrangler deploy` creates the database on first deploy (or connects to an existing one with this name)
            "database_name": "serverless-todos",
            "migrations_dir": "drizzle",
        },
    ],
    // Settings of the Worker Previews (production settings aren't inherited)
    "previews": {
        "observability": {
            "enabled": true,
        },
        "vars": {
            "ACCESS_TEAM_DOMAIN": "https://vivid-planet-sandbox.cloudflareaccess.com",
            // AUD tag of the Access application protecting the Preview URLs (not the production one), see README
            "ACCESS_AUD": "dcacc8dc414027c9cafbca4e91f53dcacd16c652f18fee944fd50b646850a67d",
            "AI_BASE_URL": "https://api.openai.com/v1",
            "AI_MODEL": "gpt-5-mini",
        },
        // d1_databases: every Preview gets its own database, added at build time by scripts/preview.ts (see vite.config.ts)
    },
}
