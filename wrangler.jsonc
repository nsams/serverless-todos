{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "serverless-todos",
    "compatibility_date": "2026-10-20",
    "compatibility_flags": ["nodejs_compat"],
    // Workers Logs: persisted runtime logs (dashboard → Worker → Observability → Events)
    "observability": {
        "enabled": true,
    },
    "main": "src/server.ts",
    // served on workers.dev, protected by Cloudflare Access (see README)
    "workers_dev": true,
    // Worker Previews on workers.dev (<preview-name>-serverless-todos.<subdomain>.workers.dev), protected by their own Access application (see README)
    "preview_urls": true,
    // overridden locally by .env
    "vars": {
        // https://<team-name>.cloudflareaccess.com (public; used to verify the Access JWT)
        "ACCESS_TEAM_DOMAIN": "https://tight-hill-daff.cloudflareaccess.com",
        // Application Audience (AUD) Tag of the Access application (public, part of every Access JWT)
        "ACCESS_AUD": "e1e1e831a2e368c145fae82cc0100b1c0728b61c4bbf7608a53ee38e83fcedc7",
    },
    "d1_databases": [
        {
            "binding": "DB",
            // no database_id: `wrangler deploy` creates the database on first deploy (or connects to an existing one with this name)
            "database_name": "serverless-todos",
            "migrations_dir": "drizzle",
        },
    ],
    // Worker Previews (`npm run deploy:preview`, see README): Previews don't inherit the production settings
    "previews": {
        "observability": {
            "enabled": true,
        },
        "vars": {
            "ACCESS_TEAM_DOMAIN": "https://tight-hill-daff.cloudflareaccess.com",
            // AUD tag of the Access application that protects the Previews (not the production one)
            "ACCESS_AUD": "TODO-preview-access-aud",
            // new users get sample lists and todos (src/db/fixtures.server.ts)
            "SEED_FIXTURES": "true",
        },
        // every Preview gets its own database: set by scripts/deployPreview.ts (database created on the first deploy of a Preview)
        "d1_databases": [],
    },
}
