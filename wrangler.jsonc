{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "serverless-todos",
    "compatibility_date": "2026-10-20",
    "compatibility_flags": ["nodejs_compat"],
    // Workers Logs: persisted runtime logs (dashboard → Worker → Logs)
    "observability": {
        "enabled": true,
    },
    "main": "src/server.ts",
    // served on workers.dev, protected by Cloudflare Access (see README); preview URLs would need their own Access setup
    "workers_dev": true,
    "preview_urls": false,
    // overridden locally by .env
    "vars": {
        // Application Audience (AUD) Tag of the Access application (public, part of every Access JWT)
        "ACCESS_AUD": "e1e1e831a2e368c145fae82cc0100b1c0728b61c4bbf7608a53ee38e83fcedc7",
    },
    "d1_databases": [
        {
            "binding": "DB",
            // no database_id: `wrangler deploy` creates the database on first deploy (or connects to an existing one with this name)
            "database_name": "serverless-todos",
            "migrations_dir": "drizzle",
        },
    ],
}
