{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "serverless-todos",
    "compatibility_date": "2026-10-20",
    "compatibility_flags": ["nodejs_compat"],
    // Workers Logs: persisted runtime logs (dashboard → Worker → Observability → Events)
    "observability": {
        "enabled": true,
    },
    "main": "src/server.ts",
    // The app is a single-page application (index.html, built by Vite): unknown paths get index.html (the client-side router shows the page),
    // only the worker's paths (REST API, chat, MCP server) go to the worker. All of it is protected by Cloudflare Access (see README).
    "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/mcp", "/chat-agent", "/chat-agent/*"],
    },
    // served on workers.dev, protected by Cloudflare Access (see README)
    "workers_dev": true,
    // Worker Previews (one per git branch, see README "Preview deployments"), protected by their own Access application
    "preview_urls": true,
    // overridden locally by .env
    "vars": {
        // https://<team-name>.cloudflareaccess.com (public; used to verify the Access JWT)
        "ACCESS_TEAM_DOMAIN": "https://vivid-planet-sandbox.cloudflareaccess.com",
        // Application Audience (AUD) Tag of the Access application (public, part of every Access JWT)
        "ACCESS_AUD": "dcacc8dc414027c9cafbca4e91f53dcacd16c652f18fee944fd50b646850a67d",
        // Model of the chat assistant: a Workers AI model with function calling (https://developers.cloudflare.com/ai/models/),
        // e.g. "@cf/zai-org/glm-4.7-flash" or the larger "@cf/moonshotai/kimi-k2.6"
        "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
        // AI Gateway the model requests go through (logs, spend limits); "default" is created on first use
        "AI_GATEWAY_ID": "default",
    },
    // Workers AI / AI Gateway (no provider API keys: billed through the Cloudflare account). Always remote, also in local development.
    "ai": {
        "binding": "AI",
    },
    // The chat assistant: one ChatAgent (Durable Object with SQLite storage for the chat history) per user, see src/chat/
    "durable_objects": {
        "bindings": [{ "name": "ChatAgent", "class_name": "ChatAgent" }],
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["TodoChatAgent"] },
        // the assistant serves all modules; keeps the existing chat histories
        { "tag": "v2", "renamed_classes": [{ "from": "TodoChatAgent", "to": "ChatAgent" }] },
    ],
    "d1_databases": [
        {
            "binding": "DB",
            // no database_id: `wrangler deploy` creates the database on first deploy (or connects to an existing one with this name)
            "database_name": "serverless-todos",
            "migrations_dir": "drizzle",
        },
    ],
    // Settings of the Worker Previews (production settings aren't inherited)
    "previews": {
        "observability": {
            "enabled": true,
        },
        "vars": {
            "ACCESS_TEAM_DOMAIN": "https://vivid-planet-sandbox.cloudflareaccess.com",
            // AUD tag of the Access application protecting the Preview URLs (not the production one), see README
            "ACCESS_AUD": "dcacc8dc414027c9cafbca4e91f53dcacd16c652f18fee944fd50b646850a67d",
            "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
            "AI_GATEWAY_ID": "default",
        },
        "ai": {
            "binding": "AI",
        },
        // Cloudflare creates a separate Durable Object namespace (chat histories) for every Preview; class and migrations are the top-level ones
        "durable_objects": {
            "bindings": [{ "name": "ChatAgent", "class_name": "ChatAgent" }],
        },
        // d1_databases: every Preview gets its own database, added at build time by scripts/preview.ts (see vite.config.ts)
    },
}
