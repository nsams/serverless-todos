# Defaults for local development. Override in .env.local (not committed).
# Wrangler loads this file as worker env/secrets in local dev.

APP_PORT=5180
APP_URL=http://localhost:${APP_PORT}

SESSION_SECRET=local-dev-session-secret

# dev-oidc-provider
IDP_PORT=8080
OIDC_ISSUER=http://localhost:${IDP_PORT}
OIDC_CLIENT_ID=serverless-todos
OIDC_CLIENT_SECRET=secret

