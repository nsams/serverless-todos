# Defaults for local development. Override in .env.local (not committed).
# Wrangler loads this file as worker env/secrets in local dev.

APP_PORT=5180
APP_URL=http://localhost:${APP_PORT}

SESSION_SECRET=local-dev-session-secret

# dev-oidc-provider
IDP_PORT=8080
OIDC_ISSUER=http://localhost:${IDP_PORT}
OIDC_CLIENT_ID=serverless-todos
OIDC_CLIENT_SECRET=secret

# postgres (only used with `pnpm dev:postgres`)
POSTGRESQL_PORT=5433
POSTGRESQL_USER=postgres
POSTGRESQL_PWD=postgres
POSTGRESQL_DB=todos
DATABASE_URL=postgres://${POSTGRESQL_USER}:${POSTGRESQL_PWD}@localhost:${POSTGRESQL_PORT}/${POSTGRESQL_DB}
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=${DATABASE_URL}
