# Defaults for local development. Override in .env.local (not committed).
# Wrangler loads this file as worker env/secrets in local dev (Cloudflare platform); on the Node platform it is process.env.

APP_PORT=5180

# Login in development: every request is authenticated as DEV_USER_EMAIL
# - Cloudflare platform: Cloudflare Access, simulated locally (`access.dev` in vite.config.ts)
# - Node platform: as long as OIDC_ISSUER is not set (src/server.node.ts)
ACCESS_AUD=local-dev
DEV_USER_EMAIL=admin@example.com

# Chat assistant (src/chat/model.server.ts): an OpenAI-compatible API. Without AI_API_KEY (.env.local, secret) there is no chat assistant.
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-5-mini
