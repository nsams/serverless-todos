# Defaults for local development. Override in .env.local (not committed).
# Wrangler loads this file as worker env/secrets in local dev.

APP_PORT=5180

# Cloudflare Access, simulated locally (`access.dev` in vite.config.ts): every request is authenticated as DEV_USER_EMAIL
ACCESS_AUD=local-dev
DEV_USER_EMAIL=admin@example.com

# Chat assistant in development (cloudflareAiDevProxy.ts): the model is called through the AI Gateway REST API of this account,
# with CLOUDFLARE_AI_API_TOKEN from .env.local (permission Account > Workers AI > Read).
# Not CLOUDFLARE_API_TOKEN: wrangler would use that one for deploying too.
CLOUDFLARE_AI_ACCOUNT_ID=e45f6c5d92148e7357863b7c79ce5763
